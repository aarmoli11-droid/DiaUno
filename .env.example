# Copia este archivo a .env.local y rellena los valores con tus propias claves.
# .env.local está ignorado por Git. NUNCA subas claves ni contraseñas.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_CLAVE_ANON_O_PUBLICABLE
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=
# Google OAuth: requiere proveedor configurado en Supabase y callbacks por plataforma.
ENABLE_GOOGLE_OAUTH=false
